{
  "name": "dsh-blender-chat",
  "version": "0.2.0",
  "description": "让 Blender 面板直接借用 DSH 的模型（复用 DSH 已配置的 provider，不需要在插件里填 API Key）",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": ["dsh", "dsh-plugin", "blender", "chat"],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
