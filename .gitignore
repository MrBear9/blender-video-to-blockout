# ══════════════════════════════════════════════════════════════
# 产物与数据：一律不入库
# ══════════════════════════════════════════════════════════════
# data/ 里是成片 mp4、.blend 场景、渲染图、标定数据、构建产物。
# 总大小约 590 MB，远超源码体量，且都能由源码重新生成。
# 需要时找作者要，或按 docs/ 里的流程重跑。
data/

# ══════════════════════════════════════════════════════════════
# Blender
# ══════════════════════════════════════════════════════════════
*.blend
*.blend1
*.blend2
*.blend[0-9]
*.blend@
# 崩溃恢复文件
*.blend[0-9]@

# ══════════════════════════════════════════════════════════════
# 媒体产物
# ══════════════════════════════════════════════════════════════
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.gif
*.glb
*.gltf
*.fbx
*.obj
*.stl
*.ply
*.abc
*.usd
*.usda
*.usdc

# 渲染图与预览。源码里没有图片资源，全部是产物。
*.png
*.jpg
*.jpeg
*.exr
*.hdr
*.tif
*.tiff
# 参考图如需入库，放 docs/images/ 再取消下面这行注释
# !docs/images/*.png

# ══════════════════════════════════════════════════════════════
# Python
# ══════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/

# 测试与工具产物
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
*.log

# ══════════════════════════════════════════════════════════════
# Node / DSH 插件
# ══════════════════════════════════════════════════════════════
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ══════════════════════════════════════════════════════════════
# 编辑器与系统
# ══════════════════════════════════════════════════════════════
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ══════════════════════════════════════════════════════════════
# 本地配置（可能含密钥）
# ══════════════════════════════════════════════════════════════
.env
.env.*
*.local
config.local.*
dsh-blender.config.json
# API Key 存在 Blender 的 userpref.blend 里，那个文件不在本仓库

# ══════════════════════════════════════════════════════════════
# 临时与备份
# ══════════════════════════════════════════════════════════════
# 插件构建信息：由 tools/build_zip.py 每次生成（含构建时间戳），
# 入库会让每次打包都产生一条无意义 diff。
addon/blockout_helper/build_info.json

*.tmp
*.temp
*.bak
*.bak-*
*.orig
*.rej
*.patch.diff
_cleanup_manifest*.txt
*.broken

# 插件合并前的手工备份（一次性回退点，验证完就该删）
_backup_*/

# ══════════════════════════════════════════════════════════════
# 内置的第三方桥接：不入库
# ══════════════════════════════════════════════════════════════
# DSH Blender Bridge（sixtysevenlf/dsh-blender-plugin）的 Blender 插件包
# 用的是 **GPL-3.0-or-later**，而本仓库是 MIT —— GPL 有传染性，把这份代码
# 提交进仓库会让整个 blockout_helper 的分发受 GPL 约束，两者不兼容。
#
# 所以：本地保留（装到一个插件里，界面照常两个 tab），但**不进版本控制**。
# 对外发布时用的是不含 bridge 的纯 MIT 版本，用户另装上游 zip。
#
# 需要这份代码的话：
#   python tools/fetch_bridge.py     # 从上游拉取
# 或者手工装上游的 dsh_blender_bridge.zip。
addon/blockout_helper/bridge/
